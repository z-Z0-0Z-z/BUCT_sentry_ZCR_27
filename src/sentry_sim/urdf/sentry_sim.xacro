<?xml version="1.0" encoding="UTF-8"?>
<robot name="sentry_sim" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find sentry_description)/urdf/sentry.urdf"/>

    <!-- =========================================================================
        4.1 关闭整车重力（仅仿真）
        来源：Gazebo Classic 官方 SDF 文档 <link><gravity>false</gravity>
        作用：
            planar_move 是二维平面驱动，但模型本身仍是动力学刚体。
            不关重力时，底盘撞到场地墙体后会被接触力掀翻（实测 roll 变成 -180°），
            导致 odom 姿态错乱、Nav2 目标失败。
            关闭重力后模型保持直立、只做平面运动。
            真机不使用本文件，因此不影响真机 URDF。
    ========================================================================= -->
    <gazebo reference="base_link"><gravity>false</gravity></gazebo>
    <gazebo reference="bigyaw"><gravity>false</gravity></gazebo>
    <gazebo reference="smallyaw"><gravity>false</gravity></gazebo>
    <gazebo reference="pitch"><gravity>false</gravity></gazebo>
    <gazebo reference="mid360s"><gravity>false</gravity></gazebo>

    <!-- =========================================================================
        Mid-360 雷达 + IMU 传感器（只在仿真里挂，真机 URDF 不动）
        来源：
          - 打点插件：ros2_livox_simulation 的 libros2_livox.so
          - 扫描轨迹：ros2_livox_simulation/scan_mode/mid360.csv（MID-360 非重复扫描）
          - IMU 插件：ROS 2 Humble 官方 gazebo_plugins 的 gazebo_ros_imu_sensor
        发布：
          /livox/lidar             livox_ros_driver2/msg/CustomMsg
          /livox/lidar/pointcloud  sensor_msgs/msg/PointCloud2
          /livox/imu               sensor_msgs/msg/Imu
        要点：
          - sensor 的 name 必须叫 mid360s，插件拿它当点云的 frame_id
          - <ray><scan> 里的角度和 samples 不决定激光方向，只填一个没人订阅的
            Gazebo LaserScanStamped 元数据；真正的方向来自 CSV
          - 每帧射线数 = <samples> / <downsample>，这是唯一的性能旋钮
        ========================================================================= -->
    <gazebo reference="mid360s">
      <sensor type="ray" name="mid360s">
        <pose>0 0 0 0 0 0</pose>
        <!-- 不写 always_on 的话，没有订阅者时 Gazebo 不更新传感器，
            表现为话题存在但一条消息都没有 -->
        <always_on>true</always_on>
        <visualize>false</visualize>
        #更新频率
        <update_rate>10</update_rate>

        <plugin name="livox_points_plugin" filename="libros2_livox.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>6.283185307</max_angle>
              </horizontal>
              <vertical>
                <samples>360</samples>
                <resolution>1</resolution>
                <!-- 这里写的是 CSV 实际覆盖的 -7.21° ~ +52.16°，仅元数据 -->
                <min_angle>-0.1259</min_angle>
                <max_angle>0.9104</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>200.0</max>
              <resolution>0.002</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </ray>

          <!-- 每帧 10000 条射线（你旧项目实测：3 万条时约 4Hz，1 万条能跟上 10Hz） -->
          <samples>10000</samples>
          <downsample>1</downsample>

          <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>

          <!-- CustomMsg 话题；PointCloud2 由插件自动发到 <topic>/pointcloud -->
          <topic>/livox/lidar</topic>
        </plugin>
      </sensor>

      <sensor type="imu" name="mid360s_imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="mid360s_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=livox/imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <!-- =========================================================================
       5. 模型级 Gazebo 插件（必须放在文件最末尾）
       来源：
         - planar_move：ROS 2 Humble 官方 gazebo_plugins
         - gazebo_ros2_control：ROS 2 官方 gazebo_ros2_control
       作用：
         - planar_move：订阅 /cmd_vel，发布 /odom 和 odom -> base_link 的 TF；
         - gazebo_ros2_control：创建 /controller_manager，加载
           config/controllers.yaml 里的控制器。

       为什么放在最末尾：
         URDF 转 SDF 时，Gazebo 会自动插入 <static> 标签。
         如果 <gazebo> 插件出现在 <static> 之前，Gazebo 会静默忽略这些插件，
         表现为 /odom 和 /controller_manager 都不出现。
         放在所有 link/joint 之后，生成的顺序才是 <static> 再 <plugin>。
    ========================================================================= -->
    <gazebo>
    <!-- 底盘平面移动插件。
        update_rate       插件更新频率，50Hz
        publish_odom      是否发布 /odom
        publish_odom_tf   是否发布 odom -> base_link 的 TF
        odometry_frame    里程计坐标系名字
        robot_base_frame  机器人本体坐标系名字（必须和 URDF 里的 base_link 一致） -->
        <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
            <ros>
                <!--话题的命名空间（前缀）-->
                <namespace>/sentry</namespace>
                <!--gazebo等默认订阅的都是cmd_vel，但是可以这样改名-->
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>50</update_rate>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
        </plugin>

    <!-- 来源：ROS 2 Humble gazebo_plugins / gazebo_ros_joint_pose_trajectory.cpp
        作用：订阅 JointTrajectory，直接对关节调用 SetPosition()，不走动力学。
        参数：update_rate 100Hz；remapping 把默认话题 set_joint_trajectory
            改名为 gimbal_trajectory，配合 namespace /sentry 得到
            /sentry/gimbal_trajectory。 -->
    <plugin name="gimbal_joint_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/sentry</namespace>
        <remapping>set_joint_trajectory:=gimbal_trajectory</remapping>
      </ros>
      <update_rate>100</update_rate>
    </plugin>

    <!-- 来源：gazebo_plugins / gazebo_ros_joint_state_publisher.cpp
         作用：按 update_rate 读指定关节角，发布 /joint_states。
         注意：namespace 必须是 /（根），否则变成 /sentry/joint_states，
               robot_state_publisher 收不到，TF 不会更新。 -->
    <plugin name="gimbal_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>bigyawjoint</joint_name>
      <joint_name>smallyawjoint</joint_name>
      <joint_name>pitchjoint</joint_name>
    </plugin>

  </gazebo>
</robot>
